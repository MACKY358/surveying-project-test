# Copy to .env and fill in your own values.
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5174

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=survey_app
DB_PASSWORD=change-me
DB_NAME=surveying_db
DB_POOL_SIZE=10

SESSION_SECRET=generate-a-long-random-secret
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
TRUST_PROXY=false

UPLOAD_DIR=./uploads
MAX_DOCUMENT_MB=15
MAX_BLUEPRINT_MB=60

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Trompeta Surveying <no-reply@example.com>"

